# Application
PROJECT_NAME="SP Project API"
ENVIRONMENT="development"
DEBUG=True

# Database
DATABASE_URL="postgresql+asyncpg://ankush:sp_project@db:5432/sp_project"

# Docker Compose (development defaults; change the password before deployment)
POSTGRES_DB=sp_project
POSTGRES_USER=ankush
POSTGRES_PASSWORD=sp_project
POSTGRES_PORT=5433
API_PORT=8000
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Local email testing (MailHog SMTP; its inbox is available at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@example.com
TODO_NOTIFICATION_EMAIL=todo-notifications@example.com
MAILHOG_UI_PORT=8025

# AWS Secrets Manager (create this secret in your AWS account)
AWS_SECRET_NAME="sp-project/jwt-secret"
AWS_REGION="us-east-1"

# JWT
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

AWS_PROFILE=sp-project
AWS_REGION=region
AWS_SECRET_NAME=secretname