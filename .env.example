# Application
PROJECT_NAME="SP Project API"
ENVIRONMENT="development"
DEBUG=True

# Database
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/sp_project"

# Docker Compose (development defaults; change the password before deployment)
POSTGRES_DB=sp_project
POSTGRES_USER=ankush
POSTGRES_PASSWORD=sp_project
POSTGRES_PORT=5433
API_PORT=8000

# JWT & Security
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
